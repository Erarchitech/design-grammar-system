<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DG.Core\DG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\*.png" />
  </ItemGroup>

  <!-- Phase 1303-15: net48 build for Rhino.Inside.Revit in Revit 2024 (.NET Framework runtime). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net7.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RhinoInstallDir Condition="'$(RhinoInstallDir)' == ''">C:\Program Files\Rhino 8</RhinoInstallDir>
    <RhinoCommonPath>$(RhinoInstallDir)\System\RhinoCommon.dll</RhinoCommonPath>
    <GrasshopperPath>$(RhinoInstallDir)\Plug-ins\Grasshopper\Grasshopper.dll</GrasshopperPath>
    <GhIoPath>$(RhinoInstallDir)\Plug-ins\Grasshopper\GH_IO.dll</GhIoPath>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(RhinoCommonPath)') and Exists('$(GrasshopperPath)') and Exists('$(GhIoPath)')">
    <DefineConstants>$(DefineConstants);GRASSHOPPER_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(RhinoCommonPath)') and Exists('$(GrasshopperPath)') and Exists('$(GhIoPath)')">
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoCommonPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>$(GrasshopperPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>$(GhIoPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CreateGrasshopperAssembly" AfterTargets="Build" Condition="Exists('$(GrasshopperPath)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)DG.gha" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
