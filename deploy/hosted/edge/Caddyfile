# Только для одобренного изолированного контура; сам файл не открывает ingress.
# TLS-сертификаты выдаются оператором и монтируются только для чтения.
# Caddy получает имена из обязательных переменных окружения Compose.
{$HOSTED_DG_HOST} {
    tls /etc/caddy/certs/dg.crt /etc/caddy/certs/dg.key

    @blocked path /neo4j /neo4j/* /n8n /n8n/* /data-service/docs /data-service/redoc /data-service/openapi.json /data-service/degram/admin /data-service/degram/admin/* /data-service/settings/speckle /data-service/knowledge/ingest/folder /data-service/mcp /data-service/context /data-service/context/* /data-service/llm/generate /llm/generate /data-service/execution-result
    handle @blocked {
        respond 404
    }
    @dg_public path / /index.html /config.js /assets/* /dg-think-light.gif /dg-think-dark.gif /data-service/* /llm/* /reasoner/*
    handle @dg_public {
        reverse_proxy design-grammars:80 {
            # Не передавать клиентский X-Forwarded-For как доверенный адрес.
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        respond 404
    }
}

{$HOSTED_SPECKLE_HOST} {
    tls /etc/caddy/certs/speckle.crt /etc/caddy/certs/speckle.key

    @blocked path /admin /admin/* /api/admin/* /neo4j/* /n8n/*
    handle @blocked {
        respond 404
    }
    # Набор маршрутов Speckle требует проверки на закреплённом образе.
    @speckle_public path / /auth/* /api/* /graphql /graphql/* /projects/* /models/* /streams/* /static/* /_nuxt/* /favicon.ico /favicon.png /robots.txt
    handle @speckle_public {
        reverse_proxy speckle-ingress:8080 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        respond 404
    }
}

{$HOSTED_OBJECT_HOST} {
    tls /etc/caddy/certs/object.crt /etc/caddy/certs/object.key

    # Только path-style bucket speckle-server. Никаких strip_prefix,
    # URI rewrite или изменения Host/query: это входы в S3-подпись.
    @object_public {
        method GET HEAD PUT OPTIONS
        path /speckle-server /speckle-server/*
    }
    handle @object_public {
        reverse_proxy speckle-minio:9000 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        respond 404
    }
}

# Неизвестный Host/SNI не маршрутизируется к DG, Speckle или хранилищу.
:443 {
    tls /etc/caddy/certs/dg.crt /etc/caddy/certs/dg.key
    respond 404
}
