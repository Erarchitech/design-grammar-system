# DG MODEL CONTEXT: the Revit-API part of every DG property calculator, shared by the Grasshopper shell
# (calculator_shell.py.tmpl) and the pyRevit shell (revit_shell.py.tmpl). Plain Revit API and Python only:
# it runs under CPython (Rhino.Inside.Revit) and under IronPython 2.7/3.4 (pyRevit), so no f-strings,
# annotations or other syntax IronPython 2.7 lacks.
def eid(element_or_id):
    """The integer value of an ElementId (or of an element's Id): ElementId.Value from Revit 2024 on, where
    IntegerValue was deprecated and Revit 2026 removed it (F-01, 2026-10-29)."""
    element_id = getattr(element_or_id, "Id", element_or_id)
    value = getattr(element_id, "Value", None)
    if value is None:
        value = element_id.IntegerValue
    return int(value)


def element_name(element):
    """Element.Name, also of a FamilySymbol or another ElementType: under pythonnet (pyRevit's CPython engine) their
    set-only Name hides the inherited getter and .Name raises AttributeError('Name') (live 2026-10-29: every Revit
    check on the demo PC failed with REVIT_CHECK_FAILED: Name)."""
    try:
        return element.Name
    except AttributeError:
        return DB.Element.Name.__get__(element)


def _bic(name):
    return getattr(DB.BuiltInCategory, name)


def _text_parameter(element, name):
    p = element.LookupParameter(name)
    if p is None or p.StorageType != DB.StorageType.String:
        return ""
    return (p.AsString() or "").strip()


def dg_classes(element):
    """Lower-case class labels the DG mapping wrote to the element (DG_Class, ';'-joined); none when rejected."""
    if _text_parameter(element, DG_STATE_PARAMETER).lower() == "rejected":
        return set()
    return set(c.strip().lower() for c in _text_parameter(element, DG_CLASS_PARAMETER).split(";") if c.strip())


_OPTIONS = DB.Options()
_OPTIONS.ComputeReferences = False
_OPTIONS.DetailLevel = DB.ViewDetailLevel.Fine


def element_solids(element):
    solids = []

    def walk(geometry):
        for g in geometry:
            if isinstance(g, DB.Solid):
                if g.Volume > 1e-9:
                    solids.append(g)
            elif isinstance(g, DB.GeometryInstance):
                walk(g.GetInstanceGeometry())

    geometry = element.get_Geometry(_OPTIONS)
    if geometry is not None:
        walk(geometry)
    return solids


def bbox_corners(element):
    bb = element.get_BoundingBox(None)
    if bb is None:
        return []
    pts = []
    for x in (bb.Min.X, bb.Max.X):
        for y in (bb.Min.Y, bb.Max.Y):
            for z in (bb.Min.Z, bb.Max.Z):
                pts.append(bb.Transform.OfPoint(DB.XYZ(x, y, z)))
    return pts


class ModelContext(object):
    """Model facts shared by every calculator; each fact is computed once per run."""

    def __init__(self, doc, boxes):
        self.doc = doc
        self.boxes = boxes
        self._solids = {}
        self._hits = {}
        self._candidates = {}
        self._walls = {}
        self._openings = {}
        self._mapped = None
        self.category_of = {}  # element id -> the category it is read as: its own, or one behind its DG class

    def mapped(self):
        """{class label (lower case): [element]} of every element the DG mapping classified, read once per run from
        the categories DG_Class is bound to."""
        if self._mapped is None:
            self._mapped = {}
            bound = []
            it = self.doc.ParameterBindings.ForwardIterator()
            while it.MoveNext():
                if it.Key is not None and it.Key.Name == DG_CLASS_PARAMETER:
                    bound = list(getattr(it.Current, "Categories", None) or [])
                    break
            for category in bound:
                for e in DB.FilteredElementCollector(self.doc).OfCategoryId(category.Id).WhereElementIsNotElementType():
                    for c in dg_classes(e):
                        self._mapped.setdefault(c, []).append(e)
        return self._mapped

    def solids(self, box):
        key = eid(box)
        if key not in self._solids:
            self._solids[key] = element_solids(box)
        return self._solids[key]

    def candidates(self, categories):
        """(element, (min, max)) of every instance of these categories, read once per run. OfCategory per category
        and plain Python bounding boxes: no ElementFilter objects, which Rhino.Inside.Revit's pythonnet passed to
        WherePasses as null (live 2026-10-20: every intersection failed).

        The DG mapping outranks the category: an element mapped to the class behind these categories is read whatever
        its category, and one mapped to another catalogue class leaves them (a pylon modelled as a wall but mapped
        Column is a column, not a wall)."""
        key = tuple(sorted(categories))
        if key not in self._candidates:
            rows = []
            seen = set()
            wanted = dict((CATEGORY_CLASSES[n].lower(), n) for n in reversed(key) if n in CATEGORY_CLASSES)

            def add(e, name):
                own_id = eid(e)
                if own_id in seen:
                    return
                seen.add(own_id)
                bb = e.get_BoundingBox(None)
                if bb is not None:
                    rows.append((e, (bb.Min.X, bb.Min.Y, bb.Min.Z), (bb.Max.X, bb.Max.Y, bb.Max.Z)))
                    self.category_of.setdefault(own_id, name)

            for name in key:
                for e in (DB.FilteredElementCollector(self.doc).OfCategory(_bic(name))
                          .WhereElementIsNotElementType()):
                    mine = dg_classes(e)
                    if mine & CATALOGUE_CLASSES and not (mine & set(wanted)):
                        continue
                    add(e, name)
            for label, name in sorted(wanted.items()):
                for e in self.mapped().get(label, []):
                    add(e, name)
            self._candidates[key] = rows
        return self._candidates[key]

    def _solids_intersect(self, solids_a, element):
        for b in self.solids_of(element):
            for a in solids_a:
                try:
                    common = DB.BooleanOperationsUtils.ExecuteBooleanOperation(a, b, DB.BooleanOperationsType.Intersect)
                except Exception:  # Revit cannot intersect some solids: fall back to the boxes overlapping
                    return True
                if common is not None and common.Volume > 1e-6:
                    return True
        return False

    def solids_of(self, element):
        key = eid(element)
        if key not in self._solids:
            self._solids[key] = element_solids(element)
        return self._solids[key]

    def intersecting(self, box, categories):
        key = (eid(box), tuple(categories))
        if key in self._hits:
            return self._hits[key]
        bb = box.get_BoundingBox(None)
        if bb is None:
            self._hits[key] = []
            return []
        lo = (bb.Min.X, bb.Min.Y, bb.Min.Z)
        hi = (bb.Max.X, bb.Max.Y, bb.Max.Z)
        solids = self.solids(box)
        hits = []
        for e, emin, emax in self.candidates(categories):
            if e.Id == box.Id:
                continue
            if any(min(hi[i], emax[i]) - max(lo[i], emin[i]) < TOL_FT for i in range(3)):
                continue
            if not solids or not self.solids_of(e) or self._solids_intersect(solids, e):
                hits.append(e)
        hits.sort(key=lambda e: eid(e))
        self._hits[key] = hits
        return hits

    @staticmethod
    def _box_of(element):
        bb = element.get_BoundingBox(None)
        if bb is None:
            return None
        return (bb.Min.X, bb.Min.Y, bb.Min.Z), (bb.Max.X, bb.Max.Y, bb.Max.Z)

    def near(self, box, categories, max_mm):
        """Elements of these categories (read by DG mapping, as intersecting) whose bounding box lies within max_mm of
        the box's bounding box, nearest first; touching ones included. No solid test (Phase 1303-25, D-72, live
        2026-10-25: a clearance calculator read columns with intersecting and never found one 200 mm away)."""
        own = self._box_of(box)
        if own is None:
            return []
        lo, hi = own
        limit = float(max_mm) / FEET_TO_MM + TOL_FT
        rows = []
        for e, emin, emax in self.candidates(categories):
            if e.Id == box.Id:
                continue
            gap = math.sqrt(sum(max(0.0, emin[i] - hi[i], lo[i] - emax[i]) ** 2 for i in range(3)))
            if gap <= limit:
                rows.append((gap, eid(e), e))
        rows.sort(key=lambda r: (r[0], r[1]))
        return [e for _gap, _id, e in rows]

    def plan_gap_mm(self, a, b):
        """Horizontal (plan) distance in mm between the bounding boxes of two elements, 0.0 when they overlap in plan;
        None when either has no bounding box."""
        ra, rb = self._box_of(a), self._box_of(b)
        if ra is None or rb is None:
            return None
        dx = max(0.0, rb[0][0] - ra[1][0], ra[0][0] - rb[1][0])
        dy = max(0.0, rb[0][1] - ra[1][1], ra[0][1] - rb[1][1])
        return math.sqrt(dx * dx + dy * dy) * FEET_TO_MM

    def host_floors(self, box):
        """Floors whose bounding box contains the box's plan centre and overlaps its height. An opening box sits in
        the floor's hole, so no solid of the floor intersects it (Phase 1303-25, D-72)."""
        own = self._box_of(box)
        if own is None:
            return []
        lo, hi = own
        cx, cy = (lo[0] + hi[0]) / 2.0, (lo[1] + hi[1]) / 2.0
        floors = []
        for e, emin, emax in self.candidates(["OST_Floors"]):
            if e.Id == box.Id:
                continue
            if emin[0] <= cx <= emax[0] and emin[1] <= cy <= emax[1] \
                    and min(hi[2], emax[2]) - max(lo[2], emin[2]) >= -TOL_FT:
                floors.append(e)
        floors.sort(key=lambda e: eid(e))
        return floors

    def host_walls(self, box):
        return [w for w in self.intersecting(box, ["OST_Walls"]) if isinstance(w, DB.Wall)]

    def wall_frame(self, wall):
        curve = wall.Location.Curve if isinstance(wall.Location, DB.LocationCurve) else None
        if curve is None:
            return None
        p0 = curve.GetEndPoint(0)
        d = curve.GetEndPoint(1) - p0
        if d.GetLength() < 1e-9:
            return None
        return p0, d.Normalize()

    def rect_in_wall(self, element, frame):
        """(u0, u1, z0, z1) of the element's bounding box, in feet, in the wall plane."""
        p0, d = frame
        us = []
        zs = []
        for pt in bbox_corners(element):
            us.append((pt - p0).DotProduct(d))
            zs.append(pt.Z)
        if not us:
            return None
        return (min(us), max(us), min(zs), max(zs))

    def wall_openings(self, wall, categories):
        key = (eid(wall), tuple(categories))
        if key in self._openings:
            return self._openings[key]
        wanted = set(int(_bic(c)) for c in categories)
        result = []
        for eid in wall.FindInserts(True, False, True, True):
            e = self.doc.GetElement(eid)
            if e is None or e.Category is None:
                continue
            if eid(e.Category) in wanted:
                result.append(e)
        result.sort(key=lambda e: eid(e))
        self._openings[key] = result
        return result

    def box_and_openings_in_walls(self, box, categories):
        """[(box_rect, [opening_rect, ...])] for every wall the box intersects."""
        out = []
        for wall in self.host_walls(box):
            frame = self.wall_frame(wall)
            if frame is None:
                continue
            box_rect = self.rect_in_wall(box, frame)
            if box_rect is None:
                continue
            rects = []
            for opening in self.wall_openings(wall, categories):
                r = self.rect_in_wall(opening, frame)
                if r is not None:
                    rects.append(r)
            out.append((box_rect, rects))
        return out


def collect_boxes(doc, family_filter):
    parts = [p.strip().lower() for p in (family_filter or "").split(";") if p.strip()]
    boxes = []
    collector = (DB.FilteredElementCollector(doc)
                 .OfCategory(DB.BuiltInCategory.OST_GenericModel)
                 .WhereElementIsNotElementType())
    for e in collector:
        if not isinstance(e, DB.FamilyInstance):
            continue
        name = (e.Symbol.Family.Name + " " + element_name(e.Symbol)).lower()
        if parts and not any(p in name for p in parts):
            continue
        boxes.append(e)
    boxes.sort(key=lambda e: e.UniqueId)
    return boxes


INVENTORY_CATEGORIES = ["OST_GenericModel", "OST_StructuralFraming", "OST_StructuralColumns", "OST_Columns",
                        "OST_Walls", "OST_Floors", "OST_Doors", "OST_Windows", "OST_SWallRectOpening"]


def inventory(doc, ctx=None):
    """Model counts for the report: instances per category and the Generic Model families (to pick BoxFamilyFilter)."""
    lines = []
    for name in INVENTORY_CATEGORIES:
        n = (DB.FilteredElementCollector(doc).OfCategory(_bic(name)).WhereElementIsNotElementType().GetElementCount())
        lines.append("inventory %s: %d" % (name, n))
    families = {}
    for e in (DB.FilteredElementCollector(doc).OfCategory(DB.BuiltInCategory.OST_GenericModel)
              .WhereElementIsNotElementType()):
        if isinstance(e, DB.FamilyInstance):
            key = "%s : %s" % (e.Symbol.Family.Name, element_name(e.Symbol))
            families[key] = families.get(key, 0) + 1
    for key in sorted(families, key=lambda k: (-families[k], k))[:40]:
        lines.append("generic model family: %s x%d" % (key, families[key]))
    if ctx is not None:
        for label, elements in sorted(ctx.mapped().items()):
            lines.append("inventory DG_Class %s: %d" % (label, len(elements)))
    return lines


def compute_properties(doc, family_filter, boxes=None):
    if boxes is None:
        boxes = collect_boxes(doc, family_filter)
    ctx = ModelContext(doc, boxes)
    values = []
    errors = []
    for prop in PROPERTIES:
        fn = CALCULATORS[prop["calculator"]]
        column = []
        for box in boxes:
            try:
                column.append(fn(ctx, box, prop["params"]))
            except Exception as exc:  # reported, never silently dropped
                column.append(None)
                errors.append("%s %s: %s" % (prop["dataPropertyLabel"], box.UniqueId, exc))
        values.append(column)
    return boxes, values, errors, ctx


# The model context the rules depend on (walls, columns, beams, doors, windows: every category a calculator read in
# this run) is published to the Model Viewer's base model next to the checked boxes (owner 2026-10-21).
CONTEXT_LIMIT = 4000


def context_elements(ctx):
    """(element, BuiltInCategory name) of every element a calculator read in this run."""
    seen = set()
    out = []
    for key in sorted(ctx._candidates):
        for element, _lo, _hi in ctx._candidates[key]:
            own_id = eid(element)
            if own_id in seen:
                continue
            seen.add(own_id)
            # the category it was read as: a wall mapped Column is shown with the column rule
            out.append((element, ctx.category_of.get(own_id) or (key[0] if key else "OST_Unknown")))
    return out[:CONTEXT_LIMIT]
