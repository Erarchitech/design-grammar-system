def plain(value):
    """A JSON-safe number (or None) from whatever a calculator returned."""
    if value is None:
        return None
    if isinstance(value, bool):
        return 1 if value else 0
    if isinstance(value, int):  # a count stays an integer, as PROPERTY STATE keeps it
        return int(value)
    try:
        number = float(value)
    except Exception:
        return None
    if math.isnan(number) or math.isinf(number):
        return None
    return number


def _corner(triangle, k):
    """Vertex index k of a MeshTriangle. IronPython calls the indexed property's accessor get_Index(k); pythonnet
    (pyRevit's CPython engine) may expose only the indexer Index[k]."""
    getter = getattr(triangle, "get_Index", None)
    if getter is not None:
        return int(getter(k))
    return int(triangle.Index[k])


def mapped_boxes(doc):
    """The elements the DG mapping classified as the box class (DG_Class), UniqueId order; [] without a mapping."""
    probe = ModelContext(doc, [])
    found = [e for e in probe.mapped().get(BOX_CLASS_LABEL.lower(), []) if getattr(e, "UniqueId", None)]
    found.sort(key=lambda e: e.UniqueId)
    return found


def solid_mesh(solids):
    """{units: mm, items: [mesh]} of the solids' triangulated faces, or None."""
    vertices = []
    faces = []
    for solid in solids:
        for face in solid.Faces:
            try:
                mesh = face.Triangulate()
            except Exception:
                mesh = None
            if mesh is None:
                continue
            base = len(vertices) // 3
            points = mesh.Vertices
            for point in points:
                vertices.extend([point.X * FEET_TO_MM, point.Y * FEET_TO_MM, point.Z * FEET_TO_MM])
            for t in range(mesh.NumTriangles):
                triangle = mesh.get_Triangle(t)
                faces.append([base + _corner(triangle, 0), base + _corner(triangle, 1), base + _corner(triangle, 2)])
    if not faces:
        return None
    return {"units": "mm", "items": [{"kind": "mesh", "vertices": vertices, "faces": faces}]}


_BOX_FACES = [[0, 1, 3], [0, 3, 2], [4, 6, 7], [4, 7, 5], [0, 4, 5], [0, 5, 1],
              [2, 3, 7], [2, 7, 6], [0, 2, 6], [0, 6, 4], [1, 5, 7], [1, 7, 3]]


def box_mesh(element):
    """The element's bounding box as a mesh (when it has no solid)."""
    corners = bbox_corners(element)
    if len(corners) != 8:
        return None
    vertices = []
    for point in corners:
        vertices.extend([point.X * FEET_TO_MM, point.Y * FEET_TO_MM, point.Z * FEET_TO_MM])
    return {"units": "mm", "items": [{"kind": "mesh", "vertices": vertices, "faces": [list(f) for f in _BOX_FACES]}]}


def box_label(box):
    symbol = getattr(box, "Symbol", None)
    if symbol is not None:
        return "%s : %s [%d]" % (symbol.Family.Name, element_name(symbol), eid(box))
    return "%s [%d]" % (element_name(box), eid(box))


def element_mesh(element):
    return solid_mesh(element_solids(element)) or box_mesh(element)


def run(doc, family_filter, with_context):
    # The DG mapping names the boxes (any family); without one the Generic Model family filter applies, as on the canvas.
    mapped = mapped_boxes(doc)
    boxes, values, errors, ctx = compute_properties(doc, family_filter, mapped or None)
    out_boxes = []
    for i, box in enumerate(boxes):
        try:
            mesh = element_mesh(box)
        except Exception as exc:
            mesh = None
            errors.append("mesh %s: %s" % (box.UniqueId, exc))
        out_boxes.append({
            "uniqueId": box.UniqueId,
            "label": box_label(box),
            "values": [plain(column[i]) for column in values],
            "mesh": mesh,
        })
    report = ["document: %s" % doc.Title, "boxes: %d (%s)" % (len(boxes), "DG mapping %s" % BOX_CLASS_LABEL if mapped
                                                               else "Generic Model family filter %r" % family_filter)]
    for k, prop in enumerate(PROPERTIES):
        column = [v for v in values[k] if v is not None]
        report.append("%s (%s): n=%d nodata=%d min=%s max=%s" % (
            prop["dataPropertyLabel"], prop["ruleId"], len(column), len(values[k]) - len(column),
            min(column) if column else "-", max(column) if column else "-"))
    report.extend(errors)
    report.extend(inventory(doc, ctx))
    context = []
    if with_context:
        for element, ost in context_elements(ctx):
            try:
                mesh = element_mesh(element)
            except Exception:
                mesh = None
            if mesh is None:
                continue
            category = element.Category.Name if element.Category is not None else "?"
            # "OST_Walls|Стены : name [id]": the category lets data-service show per rule only what it reads
            context.append({"label": "%s|%s : %s [%d]" % (ost, category, element_name(element), eid(element)), "geometry": mesh})
    return {
        "document": doc.Title,
        "boxClass": {"iri": BOX_CLASS_IRI, "label": BOX_CLASS_LABEL},
        "properties": [{"key": p["key"], "ruleId": p["ruleId"], "dataPropertyIri": p["dataPropertyIri"]}
                       for p in PROPERTIES],
        "boxes": out_boxes,
        "context": context,
        "report": report,
        "errors": len(errors),
    }
