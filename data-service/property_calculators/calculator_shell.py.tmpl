# Rhino.Inside.Revit gives Python 3 a second RhinoCommon (live 2026-10-21: "Rhino.UnitSystem cannot be converted to
# Rhino.UnitSystem"; boxes built with `Rhino.Geometry` reached VALIDATOR as foreign objects and were published without
# geometry). Boxes are therefore built with the RhinoCommon Grasshopper itself uses, found through GH_Brep.Value.
import System
import Grasshopper
_GH_RC = clr.GetClrType(Grasshopper.Kernel.Types.GH_Brep).GetProperty("Value").PropertyType.Assembly
_P3 = _GH_RC.GetType("Rhino.Geometry.Point3d")
_BB = _GH_RC.GetType("Rhino.Geometry.BoundingBox")


def _gh_point(x, y, z):
    return System.Activator.CreateInstance(_P3, System.Array[System.Object]([float(x), float(y), float(z)]))


def _decoded_geometry(box):
    """The box's own solids converted by Rhino.Inside (model units, true shape), joined into one Brep."""
    try:
        from RhinoInside.Revit.Convert.Geometry import GeometryDecoder
    except Exception:
        return None
    breps = []
    for solid in element_solids(box):
        try:
            b = GeometryDecoder.ToBrep(solid)
        except Exception:
            b = None
        if b is not None:
            breps.append(b)
    if not breps:
        return None
    if len(breps) == 1:
        return Grasshopper.Kernel.Types.GH_Brep(breps[0])
    brep_t = breps[0].GetType()
    joined = brep_t.GetMethod("JoinBreps", [clr.GetClrType(System.Collections.Generic.IEnumerable[brep_t]), clr.GetClrType(float)])
    try:
        out = joined.Invoke(None, [System.Collections.Generic.List[brep_t](breps), 0.001]) if joined else None
    except Exception:
        out = None
    return Grasshopper.Kernel.Types.GH_Brep(out[0] if out else breps[0])


def box_geometry(box, scale):
    decoded = _decoded_geometry(box)
    if decoded is not None:
        return decoded
    bb = box.get_BoundingBox(None)
    if bb is None:
        return None
    lo = bb.Transform.OfPoint(bb.Min)
    hi = bb.Transform.OfPoint(bb.Max)
    pmin = _gh_point(min(lo.X, hi.X) * scale, min(lo.Y, hi.Y) * scale, min(lo.Z, hi.Z) * scale)
    pmax = _gh_point(max(lo.X, hi.X) * scale, max(lo.Y, hi.Y) * scale, max(lo.Z, hi.Z) * scale)
    bbox = System.Activator.CreateInstance(_BB, System.Array[System.Object]([pmin, pmax]))
    brep = _BB.GetMethod("ToBrep").Invoke(bbox, None)
    return Grasshopper.Kernel.Types.GH_Brep(brep) if brep is not None else None


def object_reference(unique_id):
    ref = DG.Core.Mapping.MappingObjectReference()
    t = ref.GetType()
    t.GetProperty("Iri").SetValue(ref, BOX_CLASS_IRI)
    t.GetProperty("Label").SetValue(ref, BOX_CLASS_LABEL)
    t.GetProperty("NativeId").SetValue(ref, unique_id)
    return ref


# Revit feet -> Rhino model units. Not RhinoMath.UnitScale: inside Rhino.Inside.Revit pythonnet sees two
# Rhino.UnitSystem types and refuses the overload ("Rhino.UnitSystem value cannot be converted to
# Rhino.UnitSystem"), so the enum is read by name.
_FEET_IN = {"Millimeters": 304.8, "Centimeters": 30.48, "Decimeters": 3.048, "Meters": 0.3048,
            "Kilometers": 0.0003048, "Inches": 12.0, "Feet": 1.0, "Yards": 1.0 / 3.0}


def feet_to_model_scale():
    doc = Rhino.RhinoDoc.ActiveDoc
    name = str(doc.ModelUnitSystem) if doc is not None else "Feet"
    return _FEET_IN.get(name.split(".")[-1], 1.0)


def run_calculator(doc, family_filter):
    boxes, values, errors, ctx = compute_properties(doc, family_filter)
    return boxes, values, errors, feet_to_model_scale(), ctx


