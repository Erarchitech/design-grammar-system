FEET_TO_MM = 304.8
TOL_FT = 1.0 / FEET_TO_MM  # 1 mm
BOX_CLASS_IRI = "$box_class_iri"
BOX_CLASS_LABEL = "$box_class_label"
PROPERTIES = $property_table


def _bic(name):
    return getattr(DB.BuiltInCategory, name)


def _category_filter(names):
    cats = List[DB.BuiltInCategory]()
    for name in names:
        cats.Add(_bic(name))
    return DB.ElementMulticategoryFilter(cats)


_OPTIONS = DB.Options()
_OPTIONS.ComputeReferences = False
_OPTIONS.DetailLevel = DB.ViewDetailLevel.Fine


def element_solids(element):
    solids = []

    def walk(geometry):
        for g in geometry:
            if isinstance(g, DB.Solid):
                if g.Volume > 1e-9:
                    solids.append(g)
            elif isinstance(g, DB.GeometryInstance):
                walk(g.GetInstanceGeometry())

    geometry = element.get_Geometry(_OPTIONS)
    if geometry is not None:
        walk(geometry)
    return solids


def bbox_corners(element):
    bb = element.get_BoundingBox(None)
    if bb is None:
        return []
    pts = []
    for x in (bb.Min.X, bb.Max.X):
        for y in (bb.Min.Y, bb.Max.Y):
            for z in (bb.Min.Z, bb.Max.Z):
                pts.append(bb.Transform.OfPoint(DB.XYZ(x, y, z)))
    return pts


class Context(object):
    """Model facts shared by every calculator; each fact is computed once per run."""

    def __init__(self, doc, boxes):
        self.doc = doc
        self.boxes = boxes
        self._solids = {}
        self._hits = {}
        self._walls = {}
        self._openings = {}

    def solids(self, box):
        key = box.Id.IntegerValue
        if key not in self._solids:
            self._solids[key] = element_solids(box)
        return self._solids[key]

    def intersecting(self, box, categories):
        key = (box.Id.IntegerValue, tuple(categories))
        if key in self._hits:
            return self._hits[key]
        found = {}
        solids = self.solids(box)
        if solids:
            for solid in solids:
                collector = (DB.FilteredElementCollector(self.doc)
                             .WherePasses(_category_filter(categories))
                             .WhereElementIsNotElementType()
                             .WherePasses(DB.ElementIntersectsSolidFilter(solid)))
                for e in collector:
                    if e.Id != box.Id:
                        found[e.Id.IntegerValue] = e
        else:
            bb = box.get_BoundingBox(None)
            if bb is not None:
                outline = DB.Outline(bb.Min, bb.Max)
                collector = (DB.FilteredElementCollector(self.doc)
                             .WherePasses(_category_filter(categories))
                             .WhereElementIsNotElementType()
                             .WherePasses(DB.BoundingBoxIntersectsFilter(outline, -TOL_FT)))
                for e in collector:
                    if e.Id != box.Id:
                        found[e.Id.IntegerValue] = e
        hits = [found[k] for k in sorted(found)]
        self._hits[key] = hits
        return hits

    def host_walls(self, box):
        return [w for w in self.intersecting(box, ["OST_Walls"]) if isinstance(w, DB.Wall)]

    def wall_frame(self, wall):
        curve = wall.Location.Curve if isinstance(wall.Location, DB.LocationCurve) else None
        if curve is None:
            return None
        p0 = curve.GetEndPoint(0)
        d = curve.GetEndPoint(1) - p0
        if d.GetLength() < 1e-9:
            return None
        return p0, d.Normalize()

    def rect_in_wall(self, element, frame):
        """(u0, u1, z0, z1) of the element's bounding box, in feet, in the wall plane."""
        p0, d = frame
        us = []
        zs = []
        for pt in bbox_corners(element):
            us.append((pt - p0).DotProduct(d))
            zs.append(pt.Z)
        if not us:
            return None
        return (min(us), max(us), min(zs), max(zs))

    def wall_openings(self, wall, categories):
        key = (wall.Id.IntegerValue, tuple(categories))
        if key in self._openings:
            return self._openings[key]
        wanted = set(int(_bic(c)) for c in categories)
        result = []
        for eid in wall.FindInserts(True, False, True, True):
            e = self.doc.GetElement(eid)
            if e is None or e.Category is None:
                continue
            if e.Category.Id.IntegerValue in wanted:
                result.append(e)
        result.sort(key=lambda e: e.Id.IntegerValue)
        self._openings[key] = result
        return result

    def box_and_openings_in_walls(self, box, categories):
        """[(box_rect, [opening_rect, ...])] for every wall the box intersects."""
        out = []
        for wall in self.host_walls(box):
            frame = self.wall_frame(wall)
            if frame is None:
                continue
            box_rect = self.rect_in_wall(box, frame)
            if box_rect is None:
                continue
            rects = []
            for opening in self.wall_openings(wall, categories):
                r = self.rect_in_wall(opening, frame)
                if r is not None:
                    rects.append(r)
            out.append((box_rect, rects))
        return out


