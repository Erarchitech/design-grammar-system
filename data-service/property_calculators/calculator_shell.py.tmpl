            Labels.append("%s : %s [%d]" % (_box.Symbol.Family.Name, _box.Symbol.Name, eid(_box)))
            UniqueIds.append(_box.UniqueId)
$output_assignments
        Report = ["document: %s" % _doc.Title, "boxes: %d" % len(_boxes)]
