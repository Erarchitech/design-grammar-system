        for _box in _boxes:
            Objects.append(object_reference(_box.UniqueId))
            Geometry.append(box_geometry(_box, _scale))
            Labels.append("%s : %s [%d]" % (_box.Symbol.Family.Name, _box.Symbol.Name, _box.Id.IntegerValue))
            UniqueIds.append(_box.UniqueId)
$output_assignments
        Report = ["document: %s" % _doc.Title, "boxes: %d" % len(_boxes)]
        for _k, _prop in enumerate(PROPERTIES):
            _col = [v for v in _values[_k] if v is not None]
            Report.append("%s (%s): n=%d min=%s max=%s" % (
                _prop["dataPropertyLabel"], _prop["ruleId"], len(_col),
                min(_col) if _col else "-", max(_col) if _col else "-"))
        Report.extend(_errors)
        Report.extend(inventory(_doc))
