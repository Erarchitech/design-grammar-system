# Design Grammar System -- environment secrets (Phase 1205, D-10)
#
# Copy this file to `.env` in the repo root:
#     cp .env.example .env
# NEVER commit `.env` -- it is already gitignored (.gitignore:1).
#
# Generate secret values locally with a CSPRNG. Do not hand-type a password.
#   Random URL-safe token (DG_SERVICE_TOKEN, LLM_MASTER_SECRET, session/write
#   secrets, etc.):
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Hex value for anything embedded in a URL, e.g. POSTGRES_PASSWORD (it is
#   interpolated into the Speckle Postgres connection strings and must not
#   contain URL-reserved characters):
#     python -c "import secrets; print(secrets.token_hex(24))"
#
# The rotation procedure for every key below lives in spec/SECURITY-BOUNDARY.md
# (authored in Phase 1205 plan 1205-16). The known-default policy that
# rejects placeholders like the ones below is data-service/secrets_policy.py.
#
# Every placeholder value in this file intentionally starts with
# `change-me-` so a verbatim copy is classified `known-default` and refused
# under the multi-user deployment profile (D-11) -- see
# tools/security/check_env_file.py.

# -- Pre-existing secrets (their current live values are pending rotation
#    until Phase 1205 plan 1205-18; see PENDING_ROTATION_KEYS) --
NEO4J_PASSWORD=change-me-neo4j-password
N8N_USER=change-me-n8n-user
N8N_PASSWORD=change-me-n8n-password
POSTGRES_PASSWORD=change-me-postgres-password
MINIO_ROOT_USER=change-me-minio-root-user
MINIO_ROOT_PASSWORD=change-me-minio-root-password
LLM_MASTER_SECRET=change-me-llm-master-secret
SPECKLE_SESSION_SECRET=change-me-speckle-session-secret
SPECKLE_WRITE_TOKEN=change-me-speckle-write-token
SPECKLE_READ_TOKEN=change-me-speckle-read-token

# -- New secrets (Phase 1205 D-01/D-04/D-05) --
DG_SERVICE_TOKEN=change-me-dg-service-token
DG_BOOTSTRAP_ADMIN_USER=change-me-dg-bootstrap-admin-user
DG_BOOTSTRAP_ADMIN_PASSWORD=change-me-dg-bootstrap-admin-password

# -- Non-secret deployment configuration (D-07) --
DG_DEPLOYMENT=local
DG_COOKIE_SECURE=false

# -- Optional, non-secret Speckle project scoping (left blank by default) --
SPECKLE_PROJECT_ID=
SPECKLE_BASE_MODEL_ID=
