Left=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1135" y="500" width="270" height="30" as="geometry"/></mxCell><mxCell id="sync-71" value="Предложение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1405" y="500" width="360" height="30" as="geometry"/></mxCell><mxCell id="sync-72" value="Редакционное" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="530" width="160" height="38" as="geometry"/></mxCell><mxCell id="sync-73" value="текст изменён, требование то же" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="530" width="270" height="38" as="geometry"/></mxCell><mxCell id="sync-74" value="обновить пункт и якорь; логика правила не меняется" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="530" width="360" height="38" as="geometry"/></mxCell><mxCell id="sync-75" value="Существенное" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="568" width="160" height="38" as="geometry"/></mxCell><mxCell id="sync-76" value="порог, условие, объект" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="568" width="270" height="38" as="geometry"/></mxCell><mxCell id="sync-77" value="новая ревизия правила" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="568" width="360" height="38" as="geometry"/></mxCell><mxCell id="sync-78" value="Новый пункт" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="606" width="160" height="38" as="geometry"/></mxCell><mxCell id="sync-79" value="изменение № N добавило пункт" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="606" width="270" height="38" as="geometry"/></mxCell><mxCell id="sync-80" value="черновик правила или чек-лист (класс E)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="606" width="360" height="38" as="geometry"/></mxCell><mxCell id="sync-81" value="Пункт исключён" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="644" width="160" height="38" as="geometry"/></mxCell><mxCell id="sync-82" value="удалён в новой редакции" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="644" width="270" height="38" as="geometry"/></mxCell><mxCell id="sync-83" value="вывод правила из действия, история сохраняется" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="644" width="360" height="38" as="geometry"/></mxCell><mxCell id="sync-84" value="Перенумерация" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="682" width="160" height="38" as="geometry"/></mxCell><mxCell id="sync-85" value="тот же текст, новый номер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="682" width="270" height="38" as="geometry"/></mxCell><mxCell id="sync-86" value="обновить якорь" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="682" width="360" height="38" as="geometry"/></mxCell><mxCell id="sync-87" value="Таблица" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="720" width="160" height="38" as="geometry"/></mxCell><mxCell id="sync-88" value="значение в ячейке" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="720" width="270" height="38" as="geometry"/></mxCell><mxCell id="sync-89" value="новые параметры; литералы в проектах пересчитываются" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="720" width="360" height="38" as="geometry"/></mxCell><mxCell id="sync-90" value="Статус документа" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="975" y="758" width="160" height="38" as="geometry"/></mxCell><mxCell id="sync-91" value="отменён или заменён" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="758" width="270" height="38" as="geometry"/></mxCell><mxCell id="sync-92" value="все правила документа: вывести или перепривязать (SUPERSEDES)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1405" y="758" width="360" height="38" as="geometry"/></mxCell><mxCell id="sync-93" value="&lt;b&gt;Приёмка: одна транзакция Neo4j (session.execute_write, как публикация Computgraph) — всё или ничего&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="1180" height="300" as="geometry"/></mxCell><mxCell id="sync-94" value="&lt;b&gt;Тег приёмки T&lt;/b&gt;&lt;br&gt;Сервер создаёт один раз: acceptedAt (UTC) + acceptanceId.&lt;br&gt;Передаётся параметром во все операции; datetime() в каждой операции не используется.&lt;br&gt;Конфликт двух приёмок → 409 (expectedRevision, DGKN-04)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="55" y="875" width="230" height="245" as="geometry"/></mxCell><mxCell id="sync-95" value="&lt;b&gt;Снимок источника&lt;/b&gt;&lt;br&gt;файл по хешу содержимого, записан до транзакции; транзакция помечает его принятым&lt;br&gt;&lt;b&gt;тег T&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="875" width="170" height="245" as="geometry"/></mxCell><mxCell id="sync-96" value="&lt;b&gt;Редакция и пункты&lt;/b&gt;&lt;br&gt;новая NormEdition, версии изменённых пунктов; отклонённые пункты остаются на старой версии&lt;br&gt;&lt;b&gt;тег T&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="482" y="875" width="170" height="245" as="geometry"/></mxCell><mxCell id="sync-97" value="&lt;b&gt;Требования&lt;/b&gt;&lt;br&gt;новые версии Requirement, ENCODED_AS → ревизия правила&lt;br&gt;&lt;b&gt;тег T&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="664" y="875" width="170" height="245" as="geometry"/></mxCell><mxCell id="sync-98" value="&lt;b&gt;Правила&lt;/b&gt;&lt;br&gt;RuleRevision (неизменяемая) + обновление головы Rule; не прошедшее проверки — приостановлено&lt;br&gt;&lt;b&gt;тег T&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="846" y="875" width="170" height="245" as="geometry"/></mxCell><mxCell id="sync-99" value="&lt;b&gt;Проекты и аудит&lt;/b&gt;&lt;br&gt;копии в проектах «по действующей редакции»; узел Acceptance, строка аудита (DGKN-05)&lt;br&gt;&lt;b&gt;тег T&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1028" y="875" width="170" height="245" as="geometry"/></mxCell><mxCell id="sync-100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync-95" target="sync-96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync-96" target="sync-97"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync-97" target="sync-98"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync-98" target="sync-99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-104" value="&lt;b&gt;После приёмки&lt;/b&gt;&lt;br&gt;• закреплённые проекты (например, после подачи на экспертизу) не меняются — получают уведомление о новой редакции;&lt;br&gt;• Design State и прогоны, затронутые изменением, помечаются «требует повторной проверки»; исторические вердикты сохраняются (DGKN-06);&lt;br&gt;• состояние «источники + правила на момент T» восстанавливается по тегу; evidence хранит ревизию правила;&lt;br&gt;• PROV-O: Acceptance = prov:Activity, версии — prov:wasRevisionOf, prov:generatedAtTime = acceptedAt.&lt;br&gt;&lt;br&gt;&lt;b&gt;Пример истории (условный):&lt;/b&gt;&lt;br&gt;п. 5.3: v1 (T0) ← v2 (T1)&lt;br&gt;Requirement: v1 (T0) ← v2 (T1)&lt;br&gt;R_…_MIN_0_9_V: rev 2 (T0) ← rev 3 (T1)&lt;br&gt;T1 = 2026-10-11T14:05:12Z · acc-7f3c — один тег на всё" style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="835" width="540" height="300" as="geometry"/></mxCell><mxCell id="sync-105" value="&lt;b&gt;Инварианты&lt;/b&gt;&lt;br&gt;1. Активное правило ссылается только на принятую версию пункта.&lt;br&gt;2. Принятое изменение источника и зависимые изменения правил записываются вместе или не записываются вовсе.&lt;br&gt;3. Источник и правило никогда не расходятся молча: правило либо обновлено, либо приостановлено (not_evaluated с причиной).&lt;br&gt;4. Версии неизменяемы; «Принять все» не обходит проверки — изменения, их не прошедшие, принимаются только по одному." style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1155" width="870" height="120" as="geometry"/></mxCell><mxCell id="sync-106" value="&lt;b&gt;Безопасность коннекторов&lt;/b&gt;&lt;br&gt;Сайт: список разрешённых доменов от steward, только HTTPS, запрет частных и loopback-адресов после DNS (SSRF), лимиты размера и времени, разбор PDF/DOCX в изолированном процессе.&lt;br&gt;Drive: OAuth только на чтение, токен под Fernet, не попадает в LLM и логи. Новые маршруты и роль — в SECURITY-BOUNDARY.md. Лицензированный текст: для diff читается при проверке, в базе — хеш и координаты (BYOD)." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="1155" width="850" height="120" as="geometry"/></mxCell><mxCell id="sync-107" value="&lt;b&gt;Обозначения&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="1740" height="64" as="geometry"/></mxCell><mxCell id="sync-108" value="существует, без изменений" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="160" y="1306" width="200" height="34" as="geometry"/></mxCell><mxCell id="sync-109" value="аддитивное расширение" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="374" y="1306" width="200" height="34" as="geometry"/></mxCell><mxCell id="sync-110" value="новый код / модуль" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="588" y="1306" width="200" height="34" as="geometry"/></mxCell><mxCell id="sync-111" value="структурное изменение / не заимствуем" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="802" y="1306" width="200" height="34" as="geometry"/></mxCell><mxCell id="sync-112" value="опыт Atlas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1016" y="1306" width="200" height="34" as="geometry"/></mxCell><mxCell id="sync-113" value="внешний источник" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="1"><mxGeometry x="1230" y="1306" width="200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>