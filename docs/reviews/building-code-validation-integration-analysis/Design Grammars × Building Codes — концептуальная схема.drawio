<mxfile host="Electron" agent="Claude Code" version="24.7.17"><diagram id="concept" name="1 · Концептуальная схема"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="concept-1" value="Building Code → Design Grammars: загрузка норм, автоматическая трансформация в правила и сопоставление с моделью" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1740" height="36" as="geometry"/></mxCell><mxCell id="concept-2" value="Концепция на опыте Atlas (D. Cho) и базы знаний DG · 2026-10-11 · нормы любой юрисдикции: РФ (СП, СНиП, ГОСТ), ЕС (еврокоды + национальные приложения, национальные регламенты), Канада и др." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1740" height="26" as="geometry"/></mxCell><mxCell id="concept-3" value="&lt;b&gt;1 · Источники норм&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="270" height="700" as="geometry"/></mxCell><mxCell id="concept-4" value="&lt;b&gt;Россия&lt;/b&gt;&lt;br&gt;384-ФЗ → СП (в т.ч. актуализированные СНиП), ГОСТ&lt;br&gt;PDF / DOCX / HTML официальных редакций с изменениями" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="240" height="95" as="geometry"/></mxCell><mxCell id="concept-5" value="&lt;b&gt;Реестр требований ФАУ «ФЦС»&lt;/b&gt;&lt;br&gt;XML MDATA/VIEW (~79 тыс. требований), DMODEL/PLOGIC (пилот 100 требований)&lt;br&gt;→ готовая структура, меньше работы LLM" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="245" width="240" height="95" as="geometry"/></mxCell><mxCell id="concept-6" value="&lt;b&gt;ЕС: еврокоды&lt;/b&gt;&lt;br&gt;EN 1990–1999 + национальные приложения (NDP — параметры, выбираемые страной)" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="350" width="240" height="85" as="geometry"/></mxCell><mxCell id="concept-7" value="&lt;b&gt;ЕС: национальные регламенты&lt;/b&gt;&lt;br&gt;DE MBO/LBO + DIN, UK Approved Documents, ES CTE, FR CCH …" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="445" width="240" height="85" as="geometry"/></mxCell><mxCell id="concept-8" value="&lt;b&gt;Канада и др.&lt;/b&gt;&lt;br&gt;OBC / NBC: индекс Canada_building_code_mcp (MIT) как адаптер источника" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="540" width="240" height="85" as="geometry"/></mxCell><mxCell id="concept-9" value="&lt;b&gt;BYOD (приём Atlas)&lt;/b&gt;&lt;br&gt;В граф: номер пункта, редакция, дата введения, хеш текста.&lt;br&gt;Полный текст хранится, только если позволяет лицензия; иначе берётся из экземпляра пользователя." style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="635" width="240" height="112" as="geometry"/></mxCell><mxCell id="concept-10" value="&lt;b&gt;Подключение:&lt;/b&gt; сайт · папка Google Drive · файл; проверка изменений — лист 5" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="754" width="240" height="38" as="geometry"/></mxCell><mxCell id="concept-11" value="&lt;b&gt;Профиль юрисдикции — конфигурация, не код&lt;/b&gt;&lt;br&gt;• язык и модальные формы: «должен / не допускается / рекомендуется»; shall / should / may; muss / darf nicht / soll&lt;br&gt;• шаблон нумерации пунктов, таблиц и приложений&lt;br&gt;• иерархия документов и обязательность (в РФ — реестр требований ЕИС «Стройкомплекс.РФ»)&lt;br&gt;• единицы и правила округления&lt;br&gt;• параметры NA/NDP, климатические районы&lt;br&gt;• лицензия текста → режим BYOD&lt;br&gt;&lt;i&gt;Новая страна = новый профиль и парсер, а не новая логика.&lt;/i&gt;" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="270" height="260" as="geometry"/></mxCell><mxCell id="concept-12" value="&lt;b&gt;Atlas о модели (статьи автора)&lt;/b&gt;&lt;br&gt;• проверка = вертикальный инструмент с заданными входами&lt;br&gt;• «сначала измерь»: один проход по Revit, лучи&lt;br&gt;• LLM выбирает инструмент и не считает&lt;br&gt;• не измерено → нет вердикта, не pass&lt;br&gt;• факты API вместо словарей исключений" style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="270" height="190" as="geometry"/></mxCell><mxCell id="concept-13" value='&lt;b&gt;2 · Конвейер Norm Ingest&lt;/b&gt; — новый модуль data-service (фоновые задания + опрос статуса, как execution tracking)&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;LLM участвует только в шагах 2 и 4 и только предлагает; каждый результат проходит JSON-схему, norm.verify и утверждение человеком&lt;/span&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="1120" height="360" as="geometry"/></mxCell><mxCell id="concept-14" value="без LLM" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="140" height="22" as="geometry"/></mxCell><mxCell id="concept-15" value="&lt;b&gt;1 · Разбор структуры&lt;/b&gt;&lt;br&gt;Документ → редакция → разделы → пункты; таблицы (ячейки), термины, ссылки.&lt;br&gt;Детерминированный перечень пунктов = знаменатель покрытия (урок Atlas).&lt;br&gt;Стабильный ID пункта + хеш текста; XML ФЦС читается напрямую." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="345" y="180" width="170" height="230" as="geometry"/></mxCell><mxCell id="concept-16" value="LLM предлагает" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="544" y="150" width="140" height="22" as="geometry"/></mxCell><mxCell id="concept-17" value="&lt;b&gt;2 · Извлечение требований&lt;/b&gt;&lt;br&gt;Разметка RASE (ACCORD): требование, применимость, выборка, исключение.&lt;br&gt;Модальность, объект, свойство, оператор, порог или таблица, единица.&lt;br&gt;Шлюз цитаты: каждое поле подтверждено дословной цитатой пункта (Atlas)." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="529" y="180" width="170" height="230" as="geometry"/></mxCell><mxCell id="concept-18" value="правила + LLM-подсказка" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="150" width="140" height="22" as="geometry"/></mxCell><mxCell id="concept-19" value="&lt;b&gt;3 · Триаж и измерение&lt;/b&gt;&lt;br&gt;A прямой параметр&lt;br&gt;B порог из таблицы / NDP / проекта&lt;br&gt;C геометрия или топология&lt;br&gt;D агрегат, дизъюнкция&lt;br&gt;E качественное → ручной чек-лист&lt;br&gt;A–C получают шаблон измерения M1–M8" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="713" y="180" width="170" height="230" as="geometry"/></mxCell><mxCell id="concept-20" value="LLM предлагает" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="912" y="150" width="140" height="22" as="geometry"/></mxCell><mxCell id="concept-21" value="&lt;b&gt;4 · Привязка терминов&lt;/b&gt;&lt;br&gt;NormTerm → класс и свойство словаря компании (фаза 1302).&lt;br&gt;Классификация IFC через bSDD, метки ru/en/de, единицы СИ.&lt;br&gt;Новые термины → предложение steward, не автозапись." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="897" y="180" width="170" height="230" as="geometry"/></mxCell><mxCell id="concept-22" value="без LLM" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1096" y="150" width="140" height="22" as="geometry"/></mxCell><mxCell id="concept-23" value="&lt;b&gt;5 · Детерминированный компилятор&lt;/b&gt;&lt;br&gt;Требование (JSON) → SWRL в форме нарушения по cypher_template.&lt;br&gt;Rule_Id по формату, порог — литерал.&lt;br&gt;Приведение к границе оценщика: диапазон → 2 правила, отношение → числовой индикатор, строка → код." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1081" y="180" width="170" height="230" as="geometry"/></mxCell><mxCell id="concept-24" value="человек утверждает" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="140" height="22" as="geometry"/></mxCell><mxCell id="concept-25" value="&lt;b&gt;6 · Проверка и утверждение&lt;/b&gt;&lt;br&gt;Рядом: цитата пункта ↔ требование ↔ атомы ↔ шаблон измерения ↔ поддержка оценщиком.&lt;br&gt;norm.verify: пункт есть в редакции, хеш совпадает.&lt;br&gt;Утверждённое → библиотека правил юрисдикции." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1265" y="180" width="170" height="230" as="geometry"/></mxCell><mxCell id="concept-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-15" target="concept-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-17" target="concept-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-19" target="concept-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-21" target="concept-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-23" target="concept-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-31" value="загрузка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="concept-4" target="concept-15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="187"/><mxPoint x="320" y="295"/></Array></mxGeometry></mxCell><mxCell id="concept-32" value="&lt;b&gt;Опыт Atlas&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1470" y="100" width="310" height="410" as="geometry"/></mxCell><mxCell id="concept-33" value="&lt;b&gt;Берём&lt;/b&gt;&lt;br&gt;• граф пунктов: иерархия, ссылки, таблицы, связи overrides / excludes / derives / depends_on&lt;br&gt;• шлюз цитаты и честный знаменатель покрытия&lt;br&gt;• BYOD: координаты пункта + хеш вместо текста&lt;br&gt;• резолвер: одно значение или кандидаты + недостающие факты&lt;br&gt;• «сначала измерь», три исхода измерения&lt;br&gt;• цепочка модель → измерение → норма → вердикт с запасом&lt;br&gt;• извлечение из модели только нужного правилу" style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1485" y="135" width="280" height="235" as="geometry"/></mxCell><mxCell id="concept-34" value="&lt;b&gt;Не берём&lt;/b&gt;&lt;br&gt;• вердикт от LLM или graph RAG&lt;br&gt;• сопоставление, зашитое в код каждой проверки&lt;br&gt;• запись в модель через мост&lt;br&gt;• один статус «not judged»: в DG 8 статусов" style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1485" y="380" width="280" height="115" as="geometry"/></mxCell><mxCell id="concept-35" value="&lt;b&gt;3 · Design Grammars: пять существующих графов — шестой не вводится&lt;/b&gt; (решение 2026-09-30: SpecGraph = источники и основания)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="530" width="1120" height="470" as="geometry"/></mxCell><mxCell id="concept-36" value="&lt;b&gt;SpecGraph + нормативный профиль&lt;/b&gt;&lt;br&gt;есть: SpecNote, SpecTag, SpecSession — без изменений&lt;br&gt;новое: NormDocument → NormEdition → NormClause&lt;br&gt;&amp;nbsp;&amp;nbsp;PART_OF · REFERENCES · SUPERSEDES · OVERRIDES · EXCEPTS&lt;br&gt;NormTable (ячейки), NormTerm, ApplicabilityCondition&lt;br&gt;Requirement: RASE, цитата, класс определимости, шаблон измерения, происхождение LLM&lt;br&gt;Область: &lt;b&gt;библиотека юрисдикции&lt;/b&gt;, не проект — структурное изменение модели доступа&lt;br&gt;= обобщение SourceRevision из DGKN-01 (фаза 1302)" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="345" y="575" width="300" height="255" as="geometry"/></mxCell><mxCell id="concept-37" value="&lt;b&gt;Ontograph — словарь компании&lt;/b&gt;&lt;br&gt;нейтральные классы и свойства; национальные термины — метки и соответствия (SKOS)&lt;br&gt;IFC через bSDD (модуль выравнивания)&lt;br&gt;выпуск — steward (DGKN-02/03)" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="575" width="260" height="135" as="geometry"/></mxCell><mxCell id="concept-38" value="&lt;b&gt;Metagraph&lt;/b&gt;&lt;br&gt;библиотечные шаблоны правил: origin=norm, clauseRef, edition, textHash, параметры (таблица / NDP)&lt;br&gt;проектная копия — паттерн DGKN-08&lt;br&gt;правила замысла — без изменений" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="575" width="360" height="160" as="geometry"/></mxCell><mxCell id="concept-39" value="&lt;b&gt;ComputGraph&lt;/b&gt;&lt;br&gt;без изменений: параметры GH, ATTRIBUTE_OF; Representation (Revit UniqueId → dgId)" style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="845" width="260" height="90" as="geometry"/></mxCell><mxCell id="concept-40" value="&lt;b&gt;ValidGraph&lt;/b&gt;&lt;br&gt;Run, DesignState, evidence v2 — без изменений контракта&lt;br&gt;+ clauseRef, threshold, unit, margin, measureMethod → evidence v3 (до этого — в detail)" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="845" width="360" height="130" as="geometry"/></mxCell><mxCell id="concept-41" value="&lt;b&gt;MCP-инструменты norm.*&lt;/b&gt;&lt;br&gt;search · get_clause · get_context (родитель, ссылки, таблицы, override) · verify · applicable&lt;br&gt;для шага 2, DeGram (вопросы к нормам) и объяснения вердикта" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="345" y="845" width="300" height="130" as="geometry"/></mxCell><mxCell id="concept-42" value="GROUNDED_IN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="concept-36" target="concept-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-43" value="ENCODED_AS: Requirement → Rule (мост из статьи ITcon, впервые реализуется)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0.3;entryY=1;" edge="1" parent="1" source="concept-36" target="concept-38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1183" y="779"/></Array></mxGeometry></mxCell><mxCell id="concept-44" value="REFERS_TO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.85;entryX=1;entryY=0.85;" edge="1" parent="1" source="concept-38" target="concept-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-45" value="пункты, таблицы, термины" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.283;entryY=0;" edge="1" parent="1" source="concept-15" target="concept-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-46" value="Requirement (кандидаты)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.897;entryY=0;" edge="1" parent="1" source="concept-17" target="concept-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-47" value="предложения терминов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="concept-21" target="concept-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-48" value="утверждённые шаблоны" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.764;entryY=0;" edge="1" parent="1" source="concept-25" target="concept-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-49" value='&lt;b&gt;6 · Проверка — ядро без изменений&lt;/b&gt;&lt;br&gt;Вход: Design State + правила проекта.&lt;br&gt;GH VALIDATOR / C# DG.Core (как сервис для Revit-пути), SHACL — полнота данных, 8 статусов, evidence v2.&lt;br&gt;Decision Trace: объект → измерение (метод) → правило → пункт и редакция → вердикт + запас.&lt;br&gt;&lt;font color="#B85450"&gt;&lt;b&gt;Граница:&lt;/b&gt; вердикт выносит только детерминированный оценщик по утверждённому правилу; LLM не участвует.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Статусы (8):&lt;/b&gt; passed · failed · unknown · not_evaluated · no_population · unsupported · indeterminate · error. «Не измерено» и «нет класса» → unknown с причиной, не pass.&lt;br&gt;&lt;br&gt;&lt;b&gt;Пример трассы (иллюстрация):&lt;/b&gt; дверь D-12 (UniqueId) → ширина в свету 0,78 м (M1, параметр экземпляра) → R_EVAC_DOORWIDTH_MIN_0_8_V → СП …, п. … (редакция, хеш) → failed, запас −0,02 м.&lt;br&gt;&lt;br&gt;&lt;b&gt;Повторяемость:&lt;/b&gt; одинаковые хеши evidence при повторном прогоне (DE-01).' style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#B85450;strokeWidth=2;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="530" width="310" height="470" as="geometry"/></mxCell><mxCell id="concept-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.12;" edge="1" parent="1" source="concept-38" target="concept-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="concept-49" target="concept-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-52" value="&lt;b&gt;4–5 · Активация и автоматическое сопоставление с моделью&lt;/b&gt; — сервис Model Binding (в GH эту работу сейчас делает архитектор вручную)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="1030" width="1450" height="270" as="geometry"/></mxCell><mxCell id="concept-53" value="&lt;b&gt;4 · Активация&lt;/b&gt;&lt;br&gt;Профиль проекта: юрисдикция, набор норм и редакций, класс Ф, этажность, страна NA.&lt;br&gt;Применимость: неприменимое правило не активируется, причина записывается.&lt;br&gt;Таблица / NDP → литерал." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="345" y="1080" width="222" height="205" as="geometry"/></mxCell><mxCell id="concept-54" value="&lt;b&gt;5a · BindingProfile&lt;/b&gt;&lt;br&gt;класс Ontograph → IFC (bSDD) → категория Revit по таблице IFC-экспорта Revit (факт API) + уточнение: тип, классификатор, имя или назначение помещения.&lt;br&gt;Версия, утверждение, доказательство зонда." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="584" y="1080" width="222" height="205" as="geometry"/></mxCell><mxCell id="concept-55" value="&lt;b&gt;5b · Библиотека измерений&lt;/b&gt;&lt;br&gt;M1 параметр · M2 размер, зазор (лучи) · M3 площадь, высота · M4 сумма или доля по связанным · M5 число связанных · M6 отношение помещений → число · M7 путь · M8 факт проекта" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="823" y="1080" width="222" height="205" as="geometry"/></mxCell><mxCell id="concept-56" value="&lt;b&gt;5c · План извлечения&lt;/b&gt;&lt;br&gt;Компилируется из атомов правила: категории, параметры, измерения — только нужное правилу.&lt;br&gt;LLM здесь нет: только утверждённые профили и шаблоны." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1062" y="1080" width="222" height="205" as="geometry"/></mxCell><mxCell id="concept-57" value="&lt;b&gt;5d · Чтение модели&lt;/b&gt;&lt;br&gt;Revit: новые read-инструменты apps/revit-mcp (по плану; топология помещений), проверка creationGuid, без лимитов контекста LLM.&lt;br&gt;GH: ручная привязка как сейчас. IFC — позже." style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1301" y="1080" width="222" height="205" as="geometry"/></mxCell><mxCell id="concept-58" value="&lt;b&gt;5e · Design State + покрытие&lt;/b&gt;&lt;br&gt;ObjState: класс + UniqueId/dgId; PropState: значение + метод.&lt;br&gt;Отчёт: найдено / сопоставлено / без класса — свёрнуто по категориям; без класса → unknown." style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1540" y="1080" width="222" height="205" as="geometry"/></mxCell><mxCell id="concept-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-53" target="concept-54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-54" target="concept-55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-55" target="concept-56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-56" target="concept-57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="concept-57" target="concept-58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-64" value="библиотечные правила" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.9;entryX=0.5;entryY=0;" edge="1" parent="1" source="concept-38" target="concept-53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="719"/><mxPoint x="1050" y="1015"/><mxPoint x="456" y="1015"/></Array></mxGeometry></mxCell><mxCell id="concept-65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="concept-58" target="concept-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="concept-66" value="&lt;b&gt;Обозначения&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="1320" width="1450" height="64" as="geometry"/></mxCell><mxCell id="concept-67" value="существует, без изменений" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="450" y="1336" width="200" height="34" as="geometry"/></mxCell><mxCell id="concept-68" value="аддитивное расширение" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="664" y="1336" width="200" height="34" as="geometry"/></mxCell><mxCell id="concept-69" value="новый код / модуль" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="878" y="1336" width="200" height="34" as="geometry"/></mxCell><mxCell id="concept-70" value="структурное изменение / не заимствуем" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1092" y="1336" width="200" height="34" as="geometry"/></mxCell><mxCell id="concept-71" value="опыт Atlas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1306" y="1336" width="200" height="34" as="geometry"/></mxCell><mxCell id="concept-72" value="внешний источник" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="1"><mxGeometry x="1520" y="1336" width="200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="impact" name="2 · Требования к переструктурированию"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="impact-1" value="Насколько интеграция требует переструктурировать Design Grammars" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1420" height="36" as="geometry"/></mxCell><mxCell id="impact-2" value="Ядро (оценщик, плагин GH, Design State, ValidGraph, контракт статусов) не перестраивается. Структурных изменений четыре, и каждое — новый путь рядом с существующим: библиотечная область данных, детерминированная компиляция правил из норм, автоматическое сопоставление с моделью, версии источников и правил с синхронной приёмкой изменений. Основной объём — новые модули norms и Model Binding и экран UI." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1420" height="48" as="geometry"/></mxCell><mxCell id="impact-3" value="Компонент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="230" height="36" as="geometry"/></mxCell><mxCell id="impact-4" value="Что меняется" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="116" width="820" height="36" as="geometry"/></mxCell><mxCell id="impact-5" value="Характер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="116" width="240" height="36" as="geometry"/></mxCell><mxCell id="impact-6" value="Объём" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="116" width="130" height="36" as="geometry"/></mxCell><mxCell id="impact-7" value="&lt;b&gt;C# оценщик DG.Core&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="152" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-8" value="Классы A–C — без изменений: таблицы, NDP и проектные условия разрешаются в литералы до оценки, отношения помещений — в числовые индикаторы. Позже: связи объектов (ObjectPropertyAtom), табличный builtin, агрегаты, дизъюнкция — с обновлением SWRL-SUBSET.md. Для Revit-пути — запуск DG.Core как сервиса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="152" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-9" value="Без изменений → позже структурно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1090" y="152" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-10" value="0 → L" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="152" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-11" value="&lt;b&gt;Design State (шов)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-12" value="Остаётся единственным входом оценщика. В GH его собирает архитектор, для Revit — Model Binding автоматически" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="212" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-13" value="Без изменений" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1090" y="212" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-14" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="212" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-15" value="&lt;b&gt;Плагин Grasshopper&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-16" value="METAGRAPH читает правила как обычно, новые свойства игнорируются. Опционально: показ clauseRef в VALIDATOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="272" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-17" value="Без изменений" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1090" y="272" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-18" value="0–S" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="272" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-19" value="&lt;b&gt;n8n rules-to-metagraph&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-20" value="Остаётся для правил замысла. Нормативный путь его обходит: LLM выдаёт JSON требования, Cypher пишет компилятор" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="332" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-21" value="Без изменений" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1090" y="332" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-22" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="332" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-23" value="&lt;b&gt;LLM Gateway&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-24" value="Без изменений кода. Три новые точки вызова (извлечение требований, привязка терминов, предложение сопоставления) регистрируются в REPRODUCIBILITY.md; кеш по (хеш пункта, хеш промпта, модель)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="392" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-25" value="Аддитивно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="392" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-26" value="S" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="392" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-27" value="&lt;b&gt;Metagraph (схема)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-28" value="Новые свойства Rule: origin, clauseRef, edition, textHash, libraryRuleId, jurisdiction, parameters, measureTemplate; связь ENCODED_AS; проектная копия по DGKN-08" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="452" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-29" value="Аддитивно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="452" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-30" value="S" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="452" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-31" value="&lt;b&gt;ValidGraph / evidence&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-32" value="clauseRef, threshold, unit, margin, measureMethod на строку правило–объект: сначала в detail, затем evidence v3 (EVIDENCE-CONTRACT.md)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="512" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-33" value="Аддитивно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="512" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-34" value="S" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="512" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-35" value="&lt;b&gt;Ontograph / словарь&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-36" value="Нужен словарь компании из фазы 1302 вместо классов, создаваемых в каждом проекте; метки на нескольких языках, IFC/bSDD, единицы СИ; GROUNDED_IN от терминов норм" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="572" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-37" value="Аддитивно (зависит от 1302)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="572" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-38" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="572" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-39" value="&lt;b&gt;SpecGraph&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-40" value="Новые метки NormDocument, NormEdition, NormClause, NormTable, NormTerm, Requirement, ApplicabilityCondition и связи внутри слоя. SpecNote не меняется" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="632" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-41" value="Аддитивно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="632" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-42" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="632" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-43" value="&lt;b&gt;apps/revit-mcp&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-44" value="Новые read-инструменты: чтение по плану извлечения (категории, параметры, единицы) и топология помещений (контуры, ограждающие элементы, FromRoom/ToRoom). Только чтение, проверка creationGuid, стабильность под IronPython 3.4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="692" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-45" value="Аддитивно (только чтение)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="692" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-46" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="692" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-47" value="&lt;b&gt;Модель доступа (tenancy)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="752" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-48" value="Сейчас каждый узел несёт project, а grammar-allowlist требует project: $project в каждом шаблоне. Библиотека норм общая для проектов: зарезервированная область (например, project = 'lib:RU') + отдельные эндпоинты чтения + роль steward на запись" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="752" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-49" value="Структурно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1090" y="752" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-50" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="752" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-51" value="&lt;b&gt;Путь создания правил&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="812" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-52" value="Второй путь рядом с n8n: структурированное требование → детерминированный компилятор → черновик → утверждение. Закрывает класс ошибок F6/F9/F11/F12 (выдуманные ID, порог, головы правил)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="812" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-53" value="Структурно (новый путь)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1090" y="812" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-54" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="812" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-55" value="&lt;b&gt;Сопоставление с моделью&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-56" value="Новый сервис Model Binding: BindingProfile (версии, утверждение, доказательства зонда), библиотека измерений M1–M8, компилятор плана извлечения, отчёт о покрытии → Design State. Сегодня привязка делается вручную на холсте GH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="872" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-57" value="Структурно (новый путь)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1090" y="872" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-58" value="L" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="872" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-59" value="&lt;b&gt;Версии источников и правил&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="932" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-60" value="Сейчас правило меняется на месте (MERGE по Rule_Id, правка удаляет старые атомы), истории нет. Нужны неизменяемые версии: снимок источника, редакция и версии пунктов, версии требований, RuleRevision при текущей голове Rule; приёмка изменений — одна транзакция с единым тегом acceptedAt + acceptanceId (DGKN-04…06)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="932" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-61" value="Структурно (новый путь)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1090" y="932" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-62" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="932" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-63" value="&lt;b&gt;Коннекторы источников&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="992" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-64" value="Ссылка на сайт, папка Google Drive, файл; кнопка «Проверить изменения правил»; повторная загрузка одноимённого файла; экран списка изменений. Безопасность: список разрешённых доменов и защита от SSRF, OAuth только на чтение, токен под Fernet, как ключ LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="992" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-65" value="Новый код" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1090" y="992" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-66" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="992" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-67" value="&lt;b&gt;data-service: модуль norms&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1052" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-68" value="Загрузка (PDF/DOCX/HTML/XML, лимит выше 100 КБ), парсеры по профилям юрисдикций, задания с опросом статуса, компилятор, резолвер применимости и параметров, MCP-инструменты norm.*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="1052" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-69" value="Новый код" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1090" y="1052" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-70" value="L" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="1052" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-71" value="&lt;b&gt;UI ui-v2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1112" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-72" value="Экран «Нормы»: библиотека и редакции, загрузка, очередь проверки (цитата ↔ требование ↔ атомы ↔ измерение), утверждение сопоставлений, активация в проекте; Decision Trace в Model Viewer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="1112" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-73" value="Новый код" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1090" y="1112" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-74" value="M–L" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="1112" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-75" value="&lt;b&gt;Спецификации&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1172" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-76" value="DATABASE.md, LPG-OWL-MAPPING.md (строки для новых связей), dg-shapes.ttl (SHACL-формы норм), RULE-PARTITION-POLICY.md (категория «правило из нормы»), SECURITY-BOUNDARY.md (маршруты, роль), cypher_template.txt, dataset_schema.json, новый spec/NORM-INGEST.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="1172" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-77" value="Аддитивно" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="1172" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-78" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="1172" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-79" value="&lt;b&gt;DeGram&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1232" width="230" height="60" as="geometry"/></mxCell><mxCell id="impact-80" value="Позже: инструменты norm.* для вопросов к нормам и доказательствам (аналог Ask Atlas); LLM пересказывает сохранённые доказательства" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="1232" width="820" height="60" as="geometry"/></mxCell><mxCell id="impact-81" value="Аддитивно, позже" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1090" y="1232" width="240" height="60" as="geometry"/></mxCell><mxCell id="impact-82" value="S" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="1232" width="130" height="60" as="geometry"/></mxCell><mxCell id="impact-83" value="&lt;b&gt;Предпосылки до массовой загрузки&lt;/b&gt;&lt;br&gt;1. Исправить F6/F13: MERGE по Rule_Id молча сливает два правила; пакетная загрузка сотен правил превратит редкую ошибку в системную.&lt;br&gt;2. Спроектировать SourceRevision в фазе 1302 сразу с якорем на пункт нормы и библиотечной областью (DGKN-01, DGKN-08), иначе придётся переделывать.&lt;br&gt;3. Решить, как выражать «не применимо» на уровне объекта: исключение из выборки (→ no_population) без нового статуса или новый статус с версией контракта.&lt;br&gt;4. Фаза 1301 закрыта по UAT: мост apps/revit-mcp стабилен под IronPython 3.4 до добавления read-инструментов." style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1312" width="1420" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="roadmap" name="3 · Этапы и шлюзы"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="roadmap-1" value="Этапы внедрения: от структуры норм к автоматическому сопоставлению и второй юрисдикции" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1800" height="36" as="geometry"/></mxCell><mxCell id="roadmap-2" value="Начинать с графа норм и пилотной главы, а не с моста к Revit: мост уже есть, а без графа норм извлекать нечего (вывод исследования). Каждый этап закрывается шлюзом с измеримым критерием." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1800" height="40" as="geometry"/></mxCell><mxCell id="roadmap-3" value="&lt;b&gt;0 · В рамках фазы 1302&lt;/b&gt;&lt;br&gt;• SourceRevision = обобщённый якорь: документ, редакция, пункт, хеш, применимость&lt;br&gt;• версии правил и приёмка с единым тегом (DGKN-04…06)&lt;br&gt;• библиотечная область + роль steward&lt;br&gt;• исправить F6/F13" style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="240" height="190" as="geometry"/></mxCell><mxCell id="roadmap-4" value="Шлюз: контракт якоря и версий принят; тест на слияние Rule_Id; откат транзакции приёмки" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="240" height="75" as="geometry"/></mxCell><mxCell id="roadmap-5" value="&lt;b&gt;A · Структура норм (RU)&lt;/b&gt;&lt;br&gt;• профиль РФ, парсер СП&lt;br&gt;• пилот: СП 1.13130 (эвакуация), СП 54.13330 (жилые здания)&lt;br&gt;• файл: повторная загрузка одноимённого файла → diff пунктов&lt;br&gt;• norm.search / get_clause / verify&lt;br&gt;• без LLM" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="115" width="240" height="190" as="geometry"/></mxCell><mxCell id="roadmap-6" value="Шлюз: дерево пунктов и таблиц совпадает с ручной сверкой; хеши редакций стабильны" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="240" height="75" as="geometry"/></mxCell><mxCell id="roadmap-7" value="&lt;b&gt;B · Требования и триаж&lt;/b&gt;&lt;br&gt;• извлечение RASE + шлюз цитаты&lt;br&gt;• классы A–E и шаблон измерения&lt;br&gt;• эталон: 100 пунктов, размеченных экспертом&lt;br&gt;• очередь проверки в UI" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="115" width="240" height="190" as="geometry"/></mxCell><mxCell id="roadmap-8" value="Шлюз: точность и полнота на эталоне; доля отказов norm.verify и шлюза цитаты" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="240" height="75" as="geometry"/></mxCell><mxCell id="roadmap-9" value="&lt;b&gt;C · Компилятор, активация, сопоставление&lt;/b&gt;&lt;br&gt;• JSON → SWRL по шаблону&lt;br&gt;• словарь компании + GROUNDED_IN&lt;br&gt;• BindingProfile + M1, M3, M8&lt;br&gt;• read-инструмент Revit по плану → Design State&lt;br&gt;• сайт и Google Drive: «Проверить изменения правил», приёмка источник + правила" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="115" width="240" height="190" as="geometry"/></mxCell><mxCell id="roadmap-10" value="Шлюз: сквозной прогон; отчёт покрытия; DE-01; приёмка изменения обновляет источник и правила с одним тегом" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="240" height="75" as="geometry"/></mxCell><mxCell id="roadmap-11" value="&lt;b&gt;D · Измерения и топология&lt;/b&gt;&lt;br&gt;• M2 лучи, M4–M5 связанные элементы&lt;br&gt;• M6 отношения помещений: СП 54 п. 7.20, 7.26&lt;br&gt;• M7 путь эвакуации (свой граф)" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="115" width="240" height="190" as="geometry"/></mxCell><mxCell id="roadmap-12" value="Шлюз: совпадение с ручной проверкой на эталонной модели; не измерено → unknown" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1080" y="320" width="240" height="75" as="geometry"/></mxCell><mxCell id="roadmap-13" value="&lt;b&gt;E · Вторая юрисдикция&lt;/b&gt;&lt;br&gt;• еврокод + национальное приложение (NDP как параметр)&lt;br&gt;• или OBC/NBC через Canada_building_code_mcp — сравнение с демо Atlas&lt;br&gt;• те же классы и профили сопоставления" style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="115" width="240" height="190" as="geometry"/></mxCell><mxCell id="roadmap-14" value="Шлюз: CQ7 — правило и сопоставление переиспользуются, меняется только профиль нормы" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1340" y="320" width="240" height="75" as="geometry"/></mxCell><mxCell id="roadmap-15" value="&lt;b&gt;F · Выразительность и объяснение&lt;/b&gt;&lt;br&gt;• ObjectPropertyAtom, табличный builtin, агрегаты, дизъюнкция&lt;br&gt;• Decision Trace и запас (P7)&lt;br&gt;• вопросы к нормам в DeGram (P8)" style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="115" width="240" height="190" as="geometry"/></mxCell><mxCell id="roadmap-16" value="Шлюз: рост доли классов C–D в статусе «оценено»" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1600" y="320" width="240" height="75" as="geometry"/></mxCell><mxCell id="roadmap-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-3" target="roadmap-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="roadmap-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-5" target="roadmap-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="roadmap-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-7" target="roadmap-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="roadmap-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-9" target="roadmap-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="roadmap-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-11" target="roadmap-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="roadmap-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-13" target="roadmap-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="roadmap-23" value="&lt;b&gt;Пилот (из исследования, расширен)&lt;/b&gt;&lt;br&gt;Модель rac_basic_sample_project — та же, что у Atlas; 20–40 пунктов СП, измеримых из модели: ширины дверей и проходов на путях эвакуации, минимальные площади и высоты помещений; плюс топология мокрых зон и лифтовых шахт (СП 54.13330.2022 п. 7.20, 7.26) на жилой модели.&lt;br&gt;Метрики: распределение пунктов по классам A–E и статусам; точность якоря и шлюза цитаты; доля автоматически сопоставленных классов и свойств; доля элементов без класса; совпадение с ручной проверкой; повторяемость хешей; объём извлечения против полного экспорта." style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="1800" height="90" as="geometry"/></mxCell><mxCell id="roadmap-24" value="&lt;b&gt;Что значит «автоматически»&lt;/b&gt;&lt;br&gt;Автоматически: разбор документа, извлечение требований, триаж, привязка терминов, компиляция в черновик правила, предложение сопоставления с моделью, извлечение и измерение при каждом прогоне, проверка источников на изменения и построение списка изменений.&lt;br&gt;Не автоматически: публикация правила, первое утверждение сопоставления и приёмка изменений источника (по одному или все прошедшие проверки сразу). Нормативное правило действует только после norm.verify и подтверждения человеком; профиль сопоставления утверждается один раз на шаблон компании." style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1800" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="binding" name="4 · Сопоставление с моделью: Atlas и DG"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="binding-1" value="Как правило находит элементы и свойства модели: Atlas против предлагаемого пути DG" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1740" height="36" as="geometry"/></mxCell><mxCell id="binding-2" value="Atlas: открытого кода и статьи нет; метод восстановлен по подписи к ролику и трём рабочим статьям автора (Machine-Readable Zoning, StairFit, What Revit Schedules Miss), которые используют ту же архитектуру. В квадратных скобках — источник." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1740" height="40" as="geometry"/></mxCell><mxCell id="binding-3" value="&lt;b&gt;Atlas: сопоставление задано в каждой проверке&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="540" height="960" as="geometry"/></mxCell><mxCell id="binding-4" value="&lt;b&gt;1 · Выбор проверки&lt;/b&gt;&lt;br&gt;LLM выбирает инструмент и озвучивает результат; чисел не вычисляет. «The AI never computes a number; it picks tools and reads results» [StairFit]" style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="510" height="130" as="geometry"/></mxCell><mxCell id="binding-5" value="&lt;b&gt;2 · Вертикальный инструмент&lt;/b&gt;&lt;br&gt;Категории, параметры и измерения задаёт автор инструмента. «A script makes one Revit round trip» [StairFit] через мост pyRevit Routes :48884, в котором есть execute_revit_code [README моста]. Из модели берётся только нужное проверке [подпись к ролику]" style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="510" height="130" as="geometry"/></mxCell><mxCell id="binding-6" value="&lt;b&gt;3 · Измерение&lt;/b&gt;&lt;br&gt;Пределы читаются из типа семейства; пространство измеряется лучами ReferenceIntersector: 6 вверх (высота над головой), 2 в стороны (ширина), 2 вперёд и назад. Луч без попадания = «ничего не найдено», а не «свободно» [StairFit]" style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="450" width="510" height="130" as="geometry"/></mxCell><mxCell id="binding-7" value="&lt;b&gt;4 · Значение нормы&lt;/b&gt;&lt;br&gt;Порог несёт номер пункта и страницу. Граф пунктов со связями overrides, excludes, derives, depends_on; резолвер выдаёт одно действующее значение или кандидатов + недостающие факты [Zoning]" style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="600" width="510" height="130" as="geometry"/></mxCell><mxCell id="binding-8" value="&lt;b&gt;5 · Вердикт&lt;/b&gt;&lt;br&gt;≥ порога → pass, &lt; → fail, не измерено → нет вердикта, никогда не pass [StairFit]; в Atlas — pass / fail / not judged [подпись к ролику]" style="rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="750" width="510" height="130" as="geometry"/></mxCell><mxCell id="binding-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-4" target="binding-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-5" target="binding-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-6" target="binding-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-7" target="binding-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-13" value="&lt;b&gt;Вывод по Atlas&lt;/b&gt;&lt;br&gt;Сопоставление «норма ↔ элемент» зашито в код каждой проверки. Автоматического сопоставления произвольной загруженной нормы в открытых материалах нет.&lt;br&gt;Автор сознательно против таблиц соответствия и файлов исключений («classification trap»): опирается на факты API — FilteredElementCollector, WhereElementIsNotElementType, OwnerViewId [Schedules].&lt;br&gt;Топологии помещений (смежность, «над») в демо нет; классы помещений вроде «спальня» API не знает — как Atlas их определяет, не опубликовано." style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="900" width="510" height="160" as="geometry"/></mxCell><mxCell id="binding-14" value="&lt;b&gt;DG: автоматическое сопоставление (предлагается)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="110" width="560" height="960" as="geometry"/></mxCell><mxCell id="binding-15" value="&lt;b&gt;1 · Правило&lt;/b&gt;&lt;br&gt;Атомы ClassAtom и DataPropertyAtom уже указывают на класс и свойство Ontograph (REFERS_TO). Правило из нормы дополнительно несёт шаблон измерения из шага 3." style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="150" width="530" height="130" as="geometry"/></mxCell><mxCell id="binding-16" value="&lt;b&gt;2 · Селектор класса&lt;/b&gt;&lt;br&gt;Ontograph → IFC через bSDD → категория Revit по таблице IFC-экспорта самого Revit (факт API, а не мнение). Уточнение: тип, параметр классификатора, имя или назначение помещения." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="300" width="530" height="130" as="geometry"/></mxCell><mxCell id="binding-17" value="&lt;b&gt;3 · Источник свойства&lt;/b&gt;&lt;br&gt;Шаблон измерения M1–M8 с параметрами: встроенный или общий параметр (GUID), тип или экземпляр, геометрия, топология, факт проекта; единицы — через UnitUtils (Revit хранит футы)." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="450" width="530" height="130" as="geometry"/></mxCell><mxCell id="binding-18" value="&lt;b&gt;4 · Автопредложение и утверждение&lt;/b&gt;&lt;br&gt;LLM предлагает селектор и источник по именам категорий и параметров модели (list_category_parameters уже есть) → зонд на модели: найдено N, заполненность, единицы → человек утверждает один раз на шаблон компании → BindingProfile (версия)." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="600" width="530" height="130" as="geometry"/></mxCell><mxCell id="binding-19" value="&lt;b&gt;5 · Каждый прогон без LLM&lt;/b&gt;&lt;br&gt;План извлечения → read-инструмент → снимок → Design State (ObjState: класс + UniqueId/dgId; PropState: значение + метод) → существующий оценщик → evidence." style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="750" width="530" height="130" as="geometry"/></mxCell><mxCell id="binding-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-15" target="binding-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-16" target="binding-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-17" target="binding-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-18" target="binding-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-24" value="&lt;b&gt;Как не попасть в ловушку классификации&lt;/b&gt;&lt;br&gt;• строка профиля несёт доказательство зонда и утверждающего, а не мнение;&lt;br&gt;• дополнение — элементы нужных категорий без класса — всегда в отчёте, свёрнуто по категориям, не отфильтровано;&lt;br&gt;• исключать элементы может только условие применимости из нормы, а не словарь исключений;&lt;br&gt;• элемент без класса или значения → unknown с причиной, а не пропуск." style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="900" width="530" height="160" as="geometry"/></mxCell><mxCell id="binding-25" value='&lt;b&gt;Пример: топология мокрых зон&lt;/b&gt;&lt;br&gt;&lt;span style="font-weight:normal;font-size:11px"&gt;СП 54.13330.2022 п. 7.20 (уборная, ванная, совмещённый санузел непосредственно над жилыми комнатами и кухнями не допускаются)&lt;/span&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="580" height="960" as="geometry"/></mxCell><mxCell id="binding-26" value="&lt;b&gt;1 · Требование (RASE)&lt;/b&gt;&lt;br&gt;R: не допускается размещение · A: многоквартирный жилой дом · S: уборная, ванная (душевая), совмещённый санузел над жилыми комнатами и кухнями · E: исключение для двухуровневых квартир — сверить с действующей редакцией и изменениями." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="182" width="550" height="126" as="geometry"/></mxCell><mxCell id="binding-27" value="&lt;b&gt;2 · Классы помещений&lt;/b&gt;&lt;br&gt;WetRoom, LivingRoom, Kitchen — из BindingProfile помещений: имя, назначение или классификатор («С/у», «Санузел», «WC», «Ванная» → WetRoom). Помещение без класса → unknown." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="326" width="550" height="126" as="geometry"/></mxCell><mxCell id="binding-28" value="&lt;b&gt;3 · Измерение M6&lt;/b&gt;&lt;br&gt;count_related(WetRoom, directlyAbove, {LivingRoom, Kitchen}, допуск): Room.GetBoundarySegments → контуры; уровни по отметкам; «непосредственно над» = ближайший нижний этаж + пересечение контуров в плане больше допуска. Нет контура → unknown." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="470" width="550" height="126" as="geometry"/></mxCell><mxCell id="binding-29" value="&lt;b&gt;4 · Правило в текущем подмножестве SWRL&lt;/b&gt;&lt;br&gt;WetRoom(?w) ^ livingOrKitchenBelowCount(?w, ?n) ^ swrlb:greaterThan(?n, 0) → violation(?w)&lt;br&gt;Оценщик без изменений: отношение сведено к числовому индикатору, как в фасадном тесте." style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="614" width="550" height="126" as="geometry"/></mxCell><mxCell id="binding-30" value="&lt;b&gt;5 · Другие отношения&lt;/b&gt;&lt;br&gt;Дверь соединяет помещения — FamilyInstance.FromRoom / ToRoom (Revit хранит). Смежность через стену — общий ограждающий элемент BoundarySegment.ElementId (п. 7.26: шахты лифтов смежно с жилыми комнатами). Альтернативы: IFC space boundaries 2-го уровня, TopologicPy CellComplex (модуль выравнивания top:)." style="rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="758" width="550" height="126" as="geometry"/></mxCell><mxCell id="binding-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-26" target="binding-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-27" target="binding-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-28" target="binding-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="binding-29" target="binding-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="binding-35" value="&lt;b&gt;Интерпретация — тоже норма&lt;/b&gt;&lt;br&gt;Что считать «непосредственно над» и какой допуск перекрытия брать — это толкование, а не геометрия. Оно фиксируется в MeasureDefinition и утверждается человеком вместе с правилом.&lt;br&gt;Урок Atlas: число в модели и величина в норме — разные величины с одним именем [Zoning]." style="rounded=1;arcSize=6;fillColor=#F8CECC;strokeColor=#B85450;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="910" width="550" height="150" as="geometry"/></mxCell><mxCell id="binding-36" value="&lt;b&gt;Обозначения&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1740" height="64" as="geometry"/></mxCell><mxCell id="binding-37" value="существует, без изменений" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="160" y="1096" width="200" height="34" as="geometry"/></mxCell><mxCell id="binding-38" value="аддитивное расширение" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="374" y="1096" width="200" height="34" as="geometry"/></mxCell><mxCell id="binding-39" value="новый код / модуль" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="588" y="1096" width="200" height="34" as="geometry"/></mxCell><mxCell id="binding-40" value="структурное изменение / не заимствуем" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="802" y="1096" width="200" height="34" as="geometry"/></mxCell><mxCell id="binding-41" value="опыт Atlas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1016" y="1096" width="200" height="34" as="geometry"/></mxCell><mxCell id="binding-42" value="внешний источник" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#8C8C8C;" vertex="1" parent="1"><mxGeometry x="1230" y="1096" width="200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sync" name="5 · Источники и синхронизация изменений"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sync-1" value="Источники норм и синхронизация изменений: проверка, список, приёмка с единым тегом" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1740" height="36" as="geometry"/></mxCell><mxCell id="sync-2" value="Источник подключается ссылкой на сайт, папкой Google Drive или файлом. Каждое действие приёмки (одно изменение, выбранные или все) — одна транзакция: источник и зависимые правила получают новую версию с одним и тем же временным тегом." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1740" height="40" as="geometry"/></mxCell><mxCell id="sync-3" value="&lt;b&gt;Подключение источника&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="330" as="geometry"/></mxCell><mxCell id="sync-4" value="&lt;b&gt;Ссылка на сайт&lt;/b&gt;&lt;br&gt;URL документа (PDF, DOCX, HTML, XML) или страницы-каталога; профиль сайта указывает, где на странице текст.&lt;br&gt;Изменение: ETag / Last-Modified, затем хеш нормализованного текста." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="390" height="90" as="geometry"/></mxCell><mxCell id="sync-5" value="&lt;b&gt;Папка Google Drive&lt;/b&gt;&lt;br&gt;ID папки + OAuth только на чтение; токен под Fernet, как ключ LLM.&lt;br&gt;Изменение: md5Checksum, headRevisionId, modifiedTime — без скачивания; Google Docs экспортируются и хешируются." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="243" width="390" height="90" as="geometry"/></mxCell><mxCell id="sync-6" value="&lt;b&gt;Файл&lt;/b&gt;&lt;br&gt;Загрузка в библиотеку юрисдикции.&lt;br&gt;Изменение: SHA-256 файла. Совпал — «без изменений»." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8C8C8C;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="341" width="390" height="85" as="geometry"/></mxCell><mxCell id="sync-7" value="&lt;b&gt;Запуск проверки&lt;/b&gt;&lt;br&gt;&lt;b&gt;Сайт, Drive:&lt;/b&gt; кнопка «Проверить изменения правил» — фоновое задание с опросом статуса по всем источникам библиотеки или по одному документу.&lt;br&gt;&lt;b&gt;Файл:&lt;/b&gt; автоматически при загрузке файла с тем же именем.&lt;br&gt;Сверка обозначения документа из текста (например, «СП 54.13330.2022»): если не совпало — вопрос «новая редакция или другой документ»." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="280" height="330" as="geometry"/></mxCell><mxCell id="sync-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="sync-4" target="sync-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sync-5" target="sync-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="sync-6" target="sync-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-11" value="&lt;b&gt;Построение списка изменений&lt;/b&gt; — детерминированно, кроме шага L3" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="980" height="330" as="geometry"/></mxCell><mxCell id="sync-12" value="&lt;b&gt;L1 · Документ&lt;/b&gt;&lt;br&gt;Хеш, ETag или ревизия Drive совпали → изменений нет, дальше не идём.&lt;br&gt;Источник недоступен (404, файл удалён из папки) → предупреждение, а не отмена нормы." style="rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="815" y="145" width="225" height="280" as="geometry"/></mxCell><mxCell id="sync-13" value="&lt;b&gt;L2 · Пункты&lt;/b&gt;&lt;br&gt;Новая версия разбирается тем же парсером; дерево пунктов сравнивается со старым по номеру и хешу текста; текстовый diff на сервере (difflib, как в обновлении SpecNote).&lt;br&gt;Пропало больше порога пунктов → «разбор не удался», выводы из действия не предлагаются." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1055" y="145" width="225" height="280" as="geometry"/></mxCell><mxCell id="sync-14" value="&lt;b&gt;L3 · Требования&lt;/b&gt;&lt;br&gt;LLM заново извлекает только изменённые и новые пункты.&lt;br&gt;Неизменённый пункт сохраняет утверждённое требование без вызова LLM — иначе недетерминизм модели дал бы ложные изменения правил." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1295" y="145" width="225" height="280" as="geometry"/></mxCell><mxCell id="sync-15" value="&lt;b&gt;L4 · Правила и влияние&lt;/b&gt;&lt;br&gt;Компилятор строит новые черновики правил.&lt;br&gt;Для каждого изменения: затронутые правила, проекты, привязки, Design State и прогоны; проверки: цитата, norm.verify, компиляция." style="rounded=1;arcSize=6;fillColor=#FFE6CC;strokeColor=#D79B00;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1535" y="145" width="225" height="280" as="geometry"/></mxCell><mxCell id="sync-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync-12" target="sync-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync-13" target="sync-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sync-14" target="sync-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sync-7" target="sync-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sync-20" value="&lt;b&gt;Экран «Изменения правил»&lt;/b&gt; (иллюстрация, данные условные)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="900" height="345" as="geometry"/></mxCell><mxCell id="sync-21" value="Тип" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#B3B3B3;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontStyle