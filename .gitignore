.env

# data-service runtime state (settings + connector credentials) — never commit
data-service/data/*
!data-service/data/.gitkeep

# Python bytecode cache (generated, never committed)
__pycache__/
*.pyc

# DE-01 runner output (tools/de01/run_de01.py default --out-dir) — generated
# working directory, regenerated by every run, never committed.
.de01/

# local secrets — never commit
.secrets/

# Rhino / Grasshopper source binaries — kept on disk, never in history.
# Recovered Frame/Truss sources (docs/Bridge_Truss_V4_OntologyMapping.gh,
# docs/Truss_Joint_V4_RH7.3dm) live here; the .3dm alone is 20 MB and a
# committed binary cannot be removed without rewriting history.
# Provenance is recorded in 35-UAT.md "Frame source recovered" instead.
*.gh
*.3dm

# Generated DeGram framework indexes and isolated development data
/.degram/

# graphify: track only the current graph (owner 2026-10-25); cache, dated snapshots and helper state stay local
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json

# third-party evidence downloads (papers, PDFs) are not tracked (owner 2026-10-25)
/evidence/public-*/
