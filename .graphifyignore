# graphify's own Obsidian output — NEVER index (self-reference feedback loop)
DG_OBSIDIAN/graphify/
DG_OBSIDIAN/graphify_dump/

# graphify working dir
graphify-out/

# GSD planning churn — hundreds of generated phase docs balloon the graph.
# The curated DG_OBSIDIAN vault already captures the meaningful decisions.
.planning/

